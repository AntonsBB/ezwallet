{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easy-wallet",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "site-creator-r2"
    }
  ],
  "env": {
    "production": {
      "name": "easy-wallet-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "easywallet.abbrains.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SEED_DEMO_DATA": "false",
        "TON_NETWORK": "testnet",
        "MINI_APP_URL": "https://easywallet.abbrains.xyz"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "easy-wallet-production",
          "database_id": "a4cc180f-7b8f-4268-bdaa-55bf69571adc",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "easy-wallet-media"
        }
      ],
      "triggers": {
        "crons": ["*/2 * * * *"]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
