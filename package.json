{
  "name": "ezwallet-telegram-mini-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "cross-env CLOUDFLARE_ENV=production WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "precloudflare:check": "npm run build:production",
    "cloudflare:check": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "predeploy:production": "npm run build:production",
    "deploy:production": "wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:production": "wrangler d1 migrations apply easy-wallet-production --remote --env production",
    "chain:wrapper": "node scripts/generate-acton-wrapper.mjs",
    "types:cloudflare": "wrangler types --env production",
    "types:cloudflare:check": "wrangler types --env production --check",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build",
    "test:unit": "tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "telegram:configure": "node scripts/configure-telegram.mjs"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^3.0.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@ton/tolk-abi-to-typescript": "^0.5.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
